<div class="min-h-screen"
     style="background-color: #f9fafb;"
     data-controller="lineup"
     data-lineup-max-starters-value="11"
     data-lineup-club-primary-color-value="<%= club_primary_color(@club) %>">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="bg-white shadow-sm p-6 mb-6" style="border-radius: 12px;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <%= link_to "← Voltar ao Time", @club, class: "text-gray-600 hover:text-gray-800 font-medium mb-3 inline-block", style: "color: #6b7280; text-decoration: none; font-weight: 500; margin-bottom: 0.75rem; display: inline-block;" %>
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="<%= club_avatar_style(@club, '64px') %>">
              <%= football_icon(size: '1.5rem', style: 'font-weight: 700; color: white;') %>
            </div>
            <div>
              <h1 style="font-size: 1.875rem; font-weight: 700; color: #111827;"><%= @club.name %> - <%= t('lineups.title') %></h1>
              <p style="font-size: 1.125rem; color: #6b7280;"><%= @club.division&.name || "5ª Divisão" %></p>
            </div>
          </div>
        </div>
        <div style="text-align: right;">
          <p style="font-size: 0.875rem; color: #6b7280;">Titulares Selecionados</p>
          <p style="font-size: 1.5rem; font-weight: 700; color: <%= club_primary_color(@club) %>;"><span data-lineup-target="startersCount">0</span>/11</p>
        </div>
      </div>
    </div>

    <%= form_with url: update_lineup_club_path(@club), method: :patch, local: true, id: "lineup-form" do |form| %>
      <!-- Jogadores por Posição -->
      <%
        position_groups = [
          { name: 'Goleiros', positions: ['GK'], color: '#228B22' },
          { name: 'Defesa', positions: ['CB', 'LB', 'RB'], color: '#0047AB' },
          { name: 'Meio-campo', positions: ['CDM', 'CM', 'CAM', 'LM', 'RM'], color: '#ea580c' },
          { name: 'Ataque', positions: ['LW', 'RW', 'ST'], color: '#dc2626' }
        ]
      %>

      <% position_groups.each_with_index do |group, group_index| %>
        <div class="bg-white shadow-sm p-6 mb-6" style="border-radius: 12px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <h3 style="font-size: 1.125rem; font-weight: 600; color: <%= group[:color] %>;">
              <%= group[:name] %>
            </h3>

            <!-- Seletor de Formação (apenas no primeiro grupo) -->
            <% if group_index == 0 %>
              <div style="max-width: 300px; text-align: right;">
                <label style="display: block; font-size: 0.75rem; font-weight: 500; color: #6b7280; margin-bottom: 0.25rem;">
                  🎯 Formação Tática:
                </label>
                <%= form.select :formation,
                    options_for_select([
                      ['4-4-2 - Equilibrada', '4-4-2'],
                      ['4-3-3 - Ofensiva (+15% Ataque)', '4-3-3'],
                      ['5-3-2 - Defensiva (+37% Defesa)', '5-3-2'],
                      ['4-5-1 - Meio-campo (+10% Meio)', '4-5-1'],
                      ['3-4-3 - Ultra-ofensiva (+15% Ataque)', '3-4-3'],
                      ['4-2-3-1 - Híbrida (Balanceada)', '4-2-3-1']
                    ], @lineup&.formation || '4-4-2'),
                    {},
                    {
                      data: { lineup_target: 'formationSelect', action: 'change->lineup#updateFormationDescription' },
                      style: "width: 100%; padding: 0.5rem; border: 2px solid #e5e7eb; border-radius: 6px; font-size: 0.875rem; background: white;"
                    }
                %>
                <div data-lineup-target="formationDescription" style="font-size: 0.75rem; color: #6b7280; margin-top: 0.25rem;">
                  Formação equilibrada com ataque e defesa balanceados
                </div>
              </div>
            <% end %>
          </div>

          <% group[:positions].each do |position| %>
            <% players = @players_by_position[position] || [] %>
            <% if players.any? %>
              <div class="mb-4">
                <h4 style="font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">
                  <%= t("players.positions.#{position}") %> (<%= players.count %> jogadores)
                </h4>

                <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                  <% players.each do |player| %>
                    <%
                      is_starter = @lineup_players.any? { |lp| lp.player_id == player.id && lp.starting }
                      position_text = case position
                                     when 'GK' then 'GOL'
                                     when 'CB' then 'ZAG'
                                     when 'LB', 'RB' then 'LAT'
                                     when 'CDM', 'CM', 'CAM' then 'MEI'
                                     when 'LW', 'RW', 'ST' then 'ATA'
                                     else position
                                     end
                    %>

                    <div class="player-card <%= is_starter ? 'starter' : '' %>"
                         data-lineup-target="playerCard"
                         data-player-id="<%= player.id %>"
                         data-position="<%= position %>"
                         data-action="click->lineup#togglePlayer"
                         style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem; border: 2px solid <%= is_starter ? '#22c55e' : '#e5e7eb' %>; border-radius: 8px; transition: all 0.2s; cursor: pointer; <%= is_starter ? 'background-color: #f0fdf4;' : '' %>">

                      <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <span class="position-badge" style="padding: 0.25rem 0.5rem; border-radius: 4px; color: white; font-size: 0.75rem; font-weight: 600; background-color: <%= group[:color] %>;">
                          <%= position_text %>
                        </span>
                        <span style="font-weight: 500; font-size: 0.875rem;"><%= player.name %></span>
                        <span style="font-size: 0.75rem; color: #6b7280;">🇧🇷 Brasil</span>
                      </div>

                      <div style="display: flex; align-items: center; gap: 1rem;">
                        <div style="font-size: 0.75rem; color: #6b7280;">
                          F:<%= player.strength %> E:<%= player.stamina %> V:<%= player.speed %> A:<%= player.attack %> D:<%= player.defense %> P:<%= player.passing %>
                        </div>
                        <div class="overall-rating" style="font-weight: 600; font-size: 0.875rem;"><%= player.overall %>⭐</div>
                        <div class="starter-indicator" style="width: 18px; height: 18px; border: 2px solid #22c55e; border-radius: 50%; <%= is_starter ? 'background-color: #22c55e;' : 'background-color: white;' %>"></div>
                      </div>

                      <input type="hidden" name="players[<%= position %>_<%= player.id %>]" value="<%= player.id %>" <%= is_starter ? '' : 'disabled' %>>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <!-- Botões de Ação -->
      <div class="bg-white shadow-sm p-6" style="border-radius: 12px;">
        <div style="display: flex; gap: 1rem;">
          <%= form.submit "💾 Salvar Escalação", class: "btn", style: "#{club_button_style(@club, 'primary')} flex: 1;" %>
          <button type="button" data-lineup-target="autoSelectButton" data-action="click->lineup#autoSelect" style="#{club_button_style(@club, 'secondary')} flex: 1;">
            <%= rocket_icon %> Auto Selecionar Melhores
          </button>
          <button type="button" data-lineup-target="clearLineupButton" data-action="click->lineup#clearLineup" style="#{club_button_style(@club, 'outline')} flex: 1;">
            <%= trash_icon %> Limpar Escalação
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>

