<div class="min-h-screen bg-gray-50">
  <div class="max-w-6xl mx-auto px-6 py-8">
    <!-- Header com ícone circular e informações -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <div class="flex items-center justify-between">
        <div>
          <%= link_to "← Voltar", @room, class: "text-gray-600 hover:text-gray-800 font-medium mb-3 inline-block" %>
          <div class="flex items-center gap-4 mb-2">
            <div class="w-16 h-16 rounded-full bg-gradient-to-r from-blue-500 to-blue-600 flex items-center justify-center">
              <%= calendar_icon(size: '2rem', class: 'text-white') %>
            </div>
            <div>
              <h1 class="text-3xl font-bold text-gray-900">
                <% if @current_round %>
                  <%= @current_round.display_name %>
                <% else %>
                  Nova Rodada
                <% end %>
              </h1>
              <p class="text-lg text-gray-600"><%= @room.name %></p>
            </div>
          </div>
        </div>

        <!-- Status da aprovação -->
        <% if @current_round %>
          <div class="text-right">
            <div class="text-sm text-gray-600 mb-1">Status da Rodada</div>
            <% case @current_round.status %>
            <% when 'preparation' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                <%= lightbulb_icon(size: '1rem', class: 'mr-1') %> Preparação
              </span>
            <% when 'approved' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                <%= trophy_icon(size: '1rem', class: 'mr-1') %> Aprovada
              </span>
            <% when 'simulating' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                <%= dice_icon(size: '1rem', class: 'mr-1') %> Simulando
              </span>
            <% when 'completed' %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                <%= save_icon(size: '1rem', class: 'mr-1') %> Finalizada
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @current_round %>
      <!-- Cards de estatísticas em grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm p-6 text-center">
          <h3 class="text-3xl font-bold text-gray-900 mb-1"><%= @total_users %></h3>
          <p class="text-sm text-gray-600 font-medium">Total de Jogadores</p>
        </div>
        <div class="bg-white rounded-lg shadow-sm p-6 text-center">
          <h3 class="text-3xl font-bold text-green-600 mb-1"><%= @approved_users %></h3>
          <p class="text-sm text-gray-600 font-medium">Já Aprovaram</p>
        </div>
        <div class="bg-white rounded-lg shadow-sm p-6 text-center">
          <h3 class="text-3xl font-bold text-orange-600 mb-1"><%= @pending_users %></h3>
          <p class="text-sm text-gray-600 font-medium">Aguardando</p>
        </div>
        <div class="bg-white rounded-lg shadow-sm p-6 text-center">
          <h3 class="text-3xl font-bold text-blue-600 mb-1"><%= @matches.count %></h3>
          <p class="text-sm text-gray-600 font-medium">Confrontos</p>
        </div>
      </div>

      <!-- Confrontos da Rodada -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
            <%= football_icon(size: '1.25rem') %> Confrontos da Rodada
          </h2>
        </div>

        <% if @matches.any? %>
          <div class="space-y-4">
            <% @matches.each do |match| %>
              <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-center justify-between">
                  <!-- Time da Casa -->
                  <div class="flex items-center flex-1">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm"
                         style="background: linear-gradient(135deg, <%= match.home_club.primary_color || '#0047AB' %>, <%= match.home_club.secondary_color || '#228B22' %>);">
                      <%= match.home_club.name[0..2].upcase %>
                    </div>
                    <div class="ml-3">
                      <p class="font-semibold text-gray-900"><%= match.home_club.name %></p>
                      <p class="text-sm text-gray-600">
                        <% if match.home_club.user %>
                          <%= users_icon(size: '0.875rem', class: 'inline') %> <%= match.home_club.user.name %>
                        <% else %>
                          CPU
                        <% end %>
                      </p>
                    </div>
                  </div>

                  <!-- Resultado ou VS -->
                  <div class="px-6 text-center">
                    <% if match.completed? %>
                      <div class="text-2xl font-bold text-gray-900">
                        <%= match.home_score %> × <%= match.away_score %>
                      </div>
                    <% else %>
                      <div class="text-lg font-semibold text-gray-500">VS</div>
                      <div class="text-xs text-gray-400">
                        <%= match.match_date.strftime("%d/%m") %>
                      </div>
                    <% end %>
                  </div>

                  <!-- Time Visitante -->
                  <div class="flex items-center flex-1 justify-end">
                    <div class="mr-3 text-right">
                      <p class="font-semibold text-gray-900"><%= match.away_club.name %></p>
                      <p class="text-sm text-gray-600">
                        <% if match.away_club.user %>
                          <%= users_icon(size: '0.875rem', class: 'inline') %> <%= match.away_club.user.name %>
                        <% else %>
                          CPU
                        <% end %>
                      </p>
                    </div>
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm"
                         style="background: linear-gradient(135deg, <%= match.away_club.primary_color || '#0047AB' %>, <%= match.away_club.secondary_color || '#228B22' %>);">
                      <%= match.away_club.name[0..2].upcase %>
                    </div>
                  </div>
                </div>

                <!-- Seus confrontos destacados -->
                <% if @user_club && (match.home_club == @user_club || match.away_club == @user_club) %>
                  <div class="mt-3 pt-3 border-t border-blue-200">
                    <div class="bg-blue-50 rounded-md p-3">
                      <p class="text-sm font-medium text-blue-800 flex items-center">
                        <%= target_icon(size: '1rem', class: 'mr-1') %>
                        Seu clube joga nesta partida!
                      </p>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="w-16 h-16 mx-auto bg-gray-200 rounded-full flex items-center justify-center text-gray-500 mb-4">
              <%= calendar_icon(size: '1.5rem') %>
            </div>
            <p class="text-gray-600">Nenhum confronto gerado ainda</p>
          </div>
        <% end %>
      </div>

      <!-- Status dos Jogadores -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
        <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2 mb-6">
          <%= users_icon(size: '1.25rem') %> Status dos Jogadores
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @users_status.each do |user_status| %>
            <div class="border rounded-lg p-4 <%= user_status[:approved?] ? 'bg-green-50 border-green-200' : 'bg-gray-50 border-gray-200' %>">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm"
                       style="background: linear-gradient(135deg, <%= user_status[:club].primary_color || '#0047AB' %>, <%= user_status[:club].secondary_color || '#228B22' %>);">
                    <%= user_status[:club].name[0..2].upcase %>
                  </div>
                  <div class="ml-3">
                    <p class="font-semibold text-gray-900"><%= user_status[:club].name %></p>
                    <p class="text-sm text-gray-600"><%= user_status[:user].name %></p>
                  </div>
                </div>

                <div>
                  <% if user_status[:approved?] %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      ✅ Pronto
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                      ⏳ Aguardando
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Ações da Rodada -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <% case @current_round.status %>
        <% when 'preparation' %>
          <% if @user_approval&.approved? %>
            <!-- Usuário já aprovou -->
            <div class="text-center py-8">
              <div class="w-16 h-16 mx-auto bg-green-100 rounded-full flex items-center justify-center text-green-600 mb-4">
                <%= trophy_icon(size: '2rem') %>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Suas alterações foram enviadas!</h3>
              <p class="text-gray-600 mb-6">Aguardando outros jogadores aprovarem suas escalações...</p>

              <div class="bg-green-50 border border-green-200 rounded-lg p-4 max-w-md mx-auto">
                <p class="text-sm text-green-800">
                  <%= "#{@approved_users}/#{@total_users}" %> jogadores aprovaram
                </p>
                <div class="w-full bg-green-200 rounded-full h-2 mt-2">
                  <div class="bg-green-600 h-2 rounded-full transition-all duration-300"
                       style="width: <%= (@approved_users.to_f / @total_users * 100).round(1) %>%"></div>
                </div>
              </div>
            </div>
          <% else %>
            <!-- Usuário ainda não aprovou -->
            <div class="text-center py-8">
              <div class="w-16 h-16 mx-auto bg-blue-100 rounded-full flex items-center justify-center text-blue-600 mb-4">
                <%= rocket_icon(size: '2rem') %>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Confirme sua escalação</h3>
              <p class="text-gray-600 mb-6">Verifique se sua formação e escalação estão corretas antes de confirmar.</p>

              <div class="flex justify-center gap-4">
                <% if @user_club %>
                  <%= link_to @user_club,
                      class: "inline-flex items-center px-6 py-3 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                    <%= lightbulb_icon(size: '1rem', class: 'mr-2') %>
                    Revisar Escalação
                  <% end %>
                <% end %>

                <%= button_to approve_room_round_path(@room, @current_round),
                    method: :patch,
                    class: "inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500",
                    data: {
                      confirm: "Tem certeza que deseja confirmar sua escalação? Você não poderá mais alterá-la após a aprovação."
                    } do %>
                  <%= rocket_icon(size: '1rem', class: 'mr-2') %>
                  Estou Pronto!
                <% end %>
              </div>
            </div>
          <% end %>

        <% when 'approved' %>
          <!-- Rodada aprovada, pronta para simular -->
          <div class="text-center py-8">
            <div class="w-16 h-16 mx-auto bg-green-100 rounded-full flex items-center justify-center text-green-600 mb-4">
              <%= dice_icon(size: '2rem') %>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Todos jogadores confirmaram!</h3>
            <p class="text-gray-600 mb-6">A rodada está pronta para ser simulada.</p>

            <% if @room.user == current_user %>
              <!-- Apenas criador da sala pode simular -->
              <%= button_to simulate_room_round_path(@room, @current_round),
                  method: :post,
                  class: "inline-flex items-center px-8 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500",
                  data: {
                    confirm: "Deseja simular todas as partidas da rodada? Esta ação não pode ser desfeita."
                  } do %>
                <%= dice_icon(size: '1.25rem', class: 'mr-2') %>
                Simular Rodada
              <% end %>
            <% else %>
              <!-- Outros jogadores veem mensagem informativa -->
              <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 max-w-md mx-auto">
                <div class="flex items-center justify-center mb-3">
                  <%= users_icon(size: '1.5rem', class: 'text-blue-600') %>
                </div>
                <p class="text-blue-800 text-sm font-medium mb-2">Aguardando o administrador</p>
                <p class="text-blue-700 text-xs">
                  Apenas <strong><%= @room.user.name %></strong> (criador da sala) pode executar a simulação.
                </p>
              </div>
            <% end %>
          </div>

        <% when 'simulating' %>
          <!-- Simulação em andamento -->
          <div class="text-center py-8">
            <div class="w-16 h-16 mx-auto bg-blue-100 rounded-full flex items-center justify-center text-blue-600 mb-4">
              <%= dice_icon(size: '2rem') %>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Simulação em andamento...</h3>
            <p class="text-gray-600 mb-6">As partidas estão sendo processadas.</p>

            <div class="animate-spin w-8 h-8 mx-auto border-4 border-blue-600 border-t-transparent rounded-full"></div>
          </div>

        <% when 'completed' %>
          <!-- Rodada finalizada -->
          <div class="text-center py-8">
            <div class="w-16 h-16 mx-auto bg-gray-100 rounded-full flex items-center justify-center text-gray-600 mb-4">
              <%= save_icon(size: '2rem') %>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Rodada Finalizada</h3>
            <p class="text-gray-600 mb-6">Todos os jogos foram simulados e os resultados estão disponíveis.</p>

            <div class="flex justify-center gap-4">
              <%= link_to simulation_results_room_round_path(@room, @current_round),
                  class: "inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700" do %>
                <%= trophy_icon(size: '1rem', class: 'mr-2') %>
                Ver Resultados
              <% end %>

              <%= link_to "#",
                  class: "inline-flex items-center px-6 py-3 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
                <%= chart_icon(size: '1rem', class: 'mr-2') %>
                Ver Classificação
              <% end %>

              <%= link_to "#",
                  class: "inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" do %>
                <%= plus_icon(size: '1rem', class: 'mr-2') %>
                Próxima Rodada
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

    <% else %>
      <!-- Primeira rodada da sala -->
      <div class="bg-white rounded-lg shadow-sm p-6">
        <div class="text-center py-12">
          <div class="w-20 h-20 mx-auto bg-blue-100 rounded-full flex items-center justify-center text-blue-600 mb-6">
            <%= plus_icon(size: '2.5rem') %>
          </div>
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Iniciar Primeira Rodada</h2>
          <p class="text-gray-600 mb-8 max-w-md mx-auto">
            Esta sala ainda não possui rodadas. Clique no botão abaixo para criar a primeira rodada e gerar os confrontos.
          </p>

          <% if @room.user == current_user %>
            <%= button_to room_rounds_path(@room),
                method: :post,
                class: "inline-flex items-center px-8 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" do %>
              <%= rocket_icon(size: '1.25rem', class: 'mr-2') %>
              Criar Primeira Rodada
            <% end %>
          <% else %>
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 max-w-md mx-auto">
              <div class="flex items-center justify-center mb-3">
                <%= users_icon(size: '1.5rem', class: 'text-blue-600') %>
              </div>
              <p class="text-blue-800 text-sm font-medium mb-2">Aguardando o administrador</p>
              <p class="text-blue-700 text-xs">
                Apenas <strong><%= @room.user.name %></strong> (criador da sala) pode iniciar a primeira rodada.
              </p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>